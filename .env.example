# ============================================================================
# SocialDock — configuration locale (copiez ce fichier vers « .env »)
# .env est ignoré par Git : n'y mettez JAMAIS de valeur commitée.
# Toutes les variables sont préfixées SOCIALDOCK_.
# ============================================================================

# ---- Réseau ---------------------------------------------------------------
# Le serveur n'écoute que la boucle locale : aucune exposition réseau.
SOCIALDOCK_HOST=127.0.0.1
SOCIALDOCK_PORT=8000
# Origines acceptées par le middleware (développement Vite uniquement).
# SOCIALDOCK_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# SOCIALDOCK_REQUIRE_LOCAL_ORIGIN=true

# ---- Données --------------------------------------------------------------
# Par défaut : %LOCALAPPDATA%\SocialDock (Windows) ou ~/.local/share/socialdock.
# SOCIALDOCK_DATA_DIR=
# Pour utiliser une autre base :
# SOCIALDOCK_DATABASE_URL=sqlite:///C:/donnees/socialdock.db

# ---- Sécurité -------------------------------------------------------------
# Laissez vide au premier lancement : une clé est générée et stockée dans
# <data_dir>/secrets/ avec des permissions restreintes.
# SOCIALDOCK_SECRET_KEY=
# Jeton de l'API d'ingestion Studio IA (généré automatiquement sinon).
# SOCIALDOCK_API_TOKEN=

# ---- Publication ----------------------------------------------------------
# true  : les comptes de démonstration sont proposés (aucun appel réseau).
# false : uniquement des comptes réels connectés.
SOCIALDOCK_DEMO_MODE=true
SOCIALDOCK_SCHEDULER_TICK_SECONDS=5
SOCIALDOCK_PUBLISH_TIMEOUT_SECONDS=120
SOCIALDOCK_MAX_PUBLISH_ATTEMPTS=3

# ---- Identifiants des applications développeur ----------------------------
# Créez VOS applications (gratuit) : voir docs/CONNECT_*.md
# YouTube : https://console.cloud.google.com/  (YouTube Data API v3)
SOCIALDOCK_GOOGLE_CLIENT_ID=
SOCIALDOCK_GOOGLE_CLIENT_SECRET=
# Instagram : https://developers.facebook.com/  (app « Business », Instagram Login)
SOCIALDOCK_META_APP_ID=
SOCIALDOCK_META_APP_SECRET=
SOCIALDOCK_META_API_VERSION=v23.0
# TikTok : https://developers.tiktok.com/  (Content Posting API)
SOCIALDOCK_TIKTOK_CLIENT_KEY=
SOCIALDOCK_TIKTOK_CLIENT_SECRET=
# Base des URLs de rappel OAuth (doit correspondre à celle déclarée chez le fournisseur).
SOCIALDOCK_OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# ---- Instagram : hébergement temporaire optionnel -------------------------
# Instagram doit pouvoir télécharger la vidéo depuis une URL publique, sauf si
# l'upload résumable (rupload) est utilisé — c'est le mode par défaut de
# SocialDock. Ne renseignez ceci que si vous hébergez vous-même les fichiers.
# SOCIALDOCK_INSTAGRAM_PUBLIC_BASE_URL=
# SOCIALDOCK_INSTAGRAM_URL_TTL_MINUTES=60
